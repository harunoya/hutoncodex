{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Remote",
  "version": "0.1.0",
  "identifier": "com.codexremote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Remote",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Remote client for Codex App Server",
    "longDescription": "A native Tauri desktop client for connecting to Codex Remote App Server with Pair codes, QR Pair, or advanced authenticated WebSockets."
  }
}
